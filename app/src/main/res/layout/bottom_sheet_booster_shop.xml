<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/panel"
    android:orientation="vertical"
    android:padding="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="#33FFFFFF" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/shop_title"
                android:textColor="@color/text_light"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/shop_subtitle"
                android:textColor="@color/text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/shopCoinChip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_chip_dark"
            android:drawableStart="@drawable/ic_coin"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="0"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </FrameLayout>

    <!-- HINT row -->
    <LinearLayout
        android:id="@+id/shopRowHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_shop_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_powerup_button">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hint" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hint"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/shopHintOwned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Owned: 0"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:id="@+id/shopHintBuy"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_shop_buy"
            android:drawableStart="@drawable/ic_coin"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="+1 · 30"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- BOMB row -->
    <LinearLayout
        android:id="@+id/shopRowBomb"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_shop_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_powerup_button">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bomb" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bomb"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/shopBombOwned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Owned: 0"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:id="@+id/shopBombBuy"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_shop_buy"
            android:drawableStart="@drawable/ic_coin"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="+1 · 80"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <!-- SHUFFLE row -->
    <LinearLayout
        android:id="@+id/shopRowShuffle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_shop_row"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_powerup_button">
            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_shuffle" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Shuffle"
                android:textColor="@color/text_light"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <TextView
                android:id="@+id/shopShuffleOwned"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Owned: 0"
                android:textColor="@color/text_muted"
                android:textSize="12sp"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <TextView
            android:id="@+id/shopShuffleBuy"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_shop_buy"
            android:drawableStart="@drawable/ic_coin"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="+1 · 60"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />
    </LinearLayout>

    <Button
        android:id="@+id/shopCloseBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="18dp"
        android:background="@android:color/transparent"
        android:text="@string/shop_close"
        android:textColor="@color/text_muted"
        android:textStyle="bold" />
</LinearLayout>
