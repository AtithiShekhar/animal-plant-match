<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen home background art -->
    <ImageView
        android:id="@+id/homeBgImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/home_game_bg" />

    <!-- Animated stars layer placeholder -->
    <View
        android:id="@+id/starsLayer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Map (custom view: vertical S-curve of nodes), wrapped in a ScrollView so the
         taller-than-screen curve scrolls cleanly. Top/bottom padding gets adjusted at runtime
         based on window insets + the bottom Play CTA height so Level 1 never hides behind it. -->
    <ScrollView
        android:id="@+id/mapScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <com.datawaves.animalmatch.ui.map.LevelMapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </ScrollView>

    <!-- Top HUD strip — paddingTop is set at runtime to clear the status bar. -->
    <LinearLayout
        android:id="@+id/hudStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/hud_height"
        android:layout_gravity="top"
        android:background="@drawable/bg_hud_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/settingsBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_chip_dark"
            android:contentDescription="@string/pause_cd"
            android:padding="6dp"
            android:src="@drawable/ic_pause" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/coinChip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_dark"
            android:drawableStart="@drawable/ic_coin"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="13"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sunChip"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_dark"
            android:drawableStart="@drawable/ic_sun"
            android:drawablePadding="6dp"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="1187"
            android:textColor="@color/text_light"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/buyBtn"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@string/sun_plus_fmt"
            android:src="@drawable/ic_plus" />
    </LinearLayout>

    <!-- Hero header — top margin is set at runtime to sit under the inset-aware HUD. -->
    <LinearLayout
        android:id="@+id/heroSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="68dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.27"
            android:text="SELECT LEVEL"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <TextView
            android:id="@+id/heroTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="4"
            android:shadowRadius="12"
            android:text="Animal Match"
            android:textColor="@color/text_light"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:ignore="HardcodedText" />

        <!-- XP indicator: player level + progress to next level -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_sun"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/heroXpLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="Lv 1  ·  0 / 400 XP"
                android:textColor="@color/text_light"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/heroProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:progressBackgroundTint="@color/timer_track"
            android:progressTint="@color/accent_yellow" />
    </LinearLayout>

    <!-- Locked feature banner — top margin is set at runtime to sit under heroSection. -->
    <TextView
        android:id="@+id/lockedBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="220dp"
        android:background="@drawable/bg_locked_banner"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:text="Complete Lv. 2 to unlock a new feature."
        android:textColor="@color/text_light"
        android:textSize="13sp"
        tools:ignore="HardcodedText" />

    <!-- Bottom Play CTA -->
    <Button
        android:id="@+id/playBtn"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_button_green"
        android:stateListAnimator="@null"
        android:text="Level 1"
        android:textAllCaps="false"
        android:textColor="@color/text_light"
        android:textSize="20sp"
        android:textStyle="bold"
        tools:ignore="HardcodedText" />
</FrameLayout>
